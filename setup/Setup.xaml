<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Unlocked Toolkit Setup" Width="640" Height="720"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="{DynamicResource BgWin}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <!-- Thin rounded progress bar -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Soft}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A plain text button (links like "Remove tools") -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" Padding="6,8" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="8,1,8,2"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Soft}"/>
    </Style>

    <!-- One tool you can pick: the whole card is the switch -->
    <DataTemplate x:Key="PickCard">
      <ToggleButton IsChecked="{Binding Selected, Mode=TwoWay}" Visibility="{Binding Listed, Converter={StaticResource Vis}}"
                    Cursor="Hand" Margin="0,0,0,10" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bg" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource BgCard}" Padding="16,14">
              <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Selected, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="12,0,0,0"/>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Background="{Binding TileBrush}" VerticalAlignment="Top" Margin="0,1,14,0">
                  <TextBlock Text="{Binding Mono}" Foreground="White" FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Pill}" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                      <TextBlock Text="{Binding Badge}" FontSize="11.5" Foreground="{DynamicResource Ink2}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgPage}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
    </DataTemplate>

    <!-- One tool while installing: a status mark, its name and what's happening -->
    <DataTemplate x:Key="WorkRow">
      <Border Padding="18,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="{Binding InRun, Converter={StaticResource Vis}}">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,14,0" VerticalAlignment="Center">
            <Ellipse Stroke="{DynamicResource Off}" StrokeThickness="2" Visibility="{Binding IsPending, Converter={StaticResource Vis}}"/>
            <Grid Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
              <Ellipse Stroke="{DynamicResource Soft}" StrokeThickness="2.5"/>
              <Path Data="M 12,1.25 A 10.75,10.75 0 0 1 22.75,12" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform x:Name="Spin" Angle="0"/></Path.RenderTransform>
                <Path.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Path.Triggers>
              </Path>
            </Grid>
            <Grid Visibility="{Binding IsOk, Converter={StaticResource Vis}}">
              <Ellipse Fill="{DynamicResource Accent}"/>
              <Path Data="M 7,12.5 L 10.5,16 L 17,8.5" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <Grid Visibility="{Binding IsFail, Converter={StaticResource Vis}}">
              <Ellipse Fill="#E5484D"/>
              <Path Data="M 12,6.5 V 13.5 M 12,17.2 V 17.4" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </Grid>
          <TextBlock DockPanel.Dock="Right" Text="{Binding StepText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel x:Name="Root" Background="{DynamicResource BgWin}">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="32,28,32,18">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="15" Background="{Binding LogoBrush}" Margin="0,0,16,0">
          <Path Data="M 15,26 H 41 V 43 H 15 Z M 20.5,26 V 19.5 A 7.5,7.5 0 0 1 34.6,16" Stroke="White" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Windows Unlocked Toolkit" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Tagline}" Style="{StaticResource Hint}" FontSize="13.5"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bottom bar -->
    <Border DockPanel.Dock="Bottom" Padding="32,14,32,22" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource BgSide}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Secondary}" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" Visibility="{Binding HasSecondary, Converter={StaticResource Vis}}" Margin="0,0,10,0" MinWidth="96"/>
          <Button Style="{StaticResource Primary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding PrimaryEnabled}" Visibility="{Binding HasPrimary, Converter={StaticResource Vis}}" MinWidth="132" IsDefault="True"/>
        </StackPanel>
        <Button Style="{StaticResource Link}" Content="{Binding LinkText}" Command="{Binding LinkCommand}" Visibility="{Binding HasLink, Converter={StaticResource Vis}}" HorizontalAlignment="Left"/>
      </DockPanel>
    </Border>

    <Grid>
      <!-- Pick tools (install) or pick tools to remove -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsPicking, Converter={StaticResource Vis}}" Focusable="False">
        <StackPanel Margin="32,4,32,20">
          <TextBlock Text="{Binding PickTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding PickHint}" Style="{StaticResource Hint}" Margin="0,3,0,14"/>
          <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource PickCard}" Focusable="False"/>

          <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding IsChoose, Converter={StaticResource Vis}}">
            <DockPanel Margin="18,15">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" IsEnabled="{Binding AutoUpdatePossible}" AutomationProperties.Name="Keep everything up to date" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="Keep everything up to date" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AutoUpdateHint}" Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock Text="{Binding Fineprint}" Style="{StaticResource Hint}" Margin="2,14,0,0" Visibility="{Binding IsChoose, Converter={StaticResource Vis}}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Working and done -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRunOrDone, Converter={StaticResource Vis}}" Focusable="False">
        <StackPanel Margin="32,4,32,20">
          <Grid Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,14" Visibility="{Binding IsDone, Converter={StaticResource Vis}}">
            <Ellipse Fill="{Binding DoneBrush}"/>
            <Path Data="M 19,33 L 28,42 L 45,23" Stroke="White" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="{Binding DoneOk, Converter={StaticResource Vis}}"/>
            <Path Data="M 32,18 V 36 M 32,45.5 V 46" Stroke="White" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding DoneFailed, Converter={StaticResource Vis}}"/>
          </Grid>
          <TextBlock Text="{Binding RunTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding RunHint}" Style="{StaticResource Lede}" Margin="0,4,0,18"/>
          <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,18" Visibility="{Binding IsWork, Converter={StaticResource Vis}}"/>
          <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource WorkRow}" Focusable="False" Margin="0,0,0,-1"/>
          </Border>
          <Button Style="{StaticResource Link}" Content="{Binding LogButtonText}" Command="{Binding ToggleLog}" HorizontalAlignment="Left" Margin="-6,0,0,6"/>
          <TextBox Text="{Binding LogText, Mode=OneWay}" Visibility="{Binding ShowLog, Converter={StaticResource Vis}}" IsReadOnly="True" Height="220"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Background="{DynamicResource BgCard}" Foreground="{DynamicResource Ink2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,8"
                   AutomationProperties.Name="Details" x:Name="Log"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
