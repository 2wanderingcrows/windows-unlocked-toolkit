<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlocked Toolkit" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </Window.Resources>

  <!-- Margin leaves room for the shadow. -->
  <Border x:Name="Panel" Margin="14" CornerRadius="12" Background="{DynamicResource BgPage}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.32" Color="#000000"/>
    </Border.Effect>
    <Border.RenderTransform>
      <TranslateTransform x:Name="Slide" Y="0"/>
    </Border.RenderTransform>
    <StackPanel>

      <!-- Header -->
      <DockPanel Margin="16,12,10,8">
        <Button DockPanel.Dock="Right" Command="{Binding OpenSettings}" Width="36" Height="36" Cursor="Hand" ToolTip="Settings" AutomationProperties.Name="Open settings" Focusable="True">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Ink2}" StrokeThickness="1.6" StrokeLineJoin="Round"
                      Data="M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 1 0 12,9 Z M 10.3,2.5 H 13.7 L 14.2,5.1 L 16.4,6.4 L 18.9,5.5 L 20.6,8.4 L 18.6,10.2 V 13.8 L 20.6,15.6 L 18.9,18.5 L 16.4,17.6 L 14.2,18.9 L 13.7,21.5 H 10.3 L 9.8,18.9 L 7.6,17.6 L 5.1,18.5 L 3.4,15.6 L 5.4,13.8 V 10.2 L 3.4,8.4 L 5.1,5.5 L 7.6,6.4 L 9.8,5.1 Z"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Accent}" VerticalAlignment="Center">
          <Path Width="13" Height="13" Stretch="Uniform" Data="M 8,14 H 22 V 23 H 8 Z M 11,14 V 11 A 4,4 0 0 1 18.5,9" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Border>
        <TextBlock Text="Unlocked Toolkit" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Leanback hero -->
      <Border Margin="12,0,12,0" CornerRadius="12" Padding="16" Background="{Binding HeroBrush}" Visibility="{Binding LeanInstalled, Converter={StaticResource Vis}}">
        <StackPanel>
          <DockPanel>
            <Path DockPanel.Dock="Left" Width="22" Height="22" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                  Data="M 6.5,8 H 17.5 A 4,4 0 0 1 21.4,12.9 L 20.4,17.2 A 2.3,2.3 0 0 1 16.4,18.1 L 14.8,16 H 9.2 L 7.6,18.1 A 2.3,2.3 0 0 1 3.6,17.2 L 2.6,12.9 A 4,4 0 0 1 6.5,8 Z M 7.5,11 V 14 M 6,12.5 H 9"/>
            <StackPanel Margin="10,0,0,0">
              <TextBlock Text="{Binding HeroTitle}" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding HeroSub}" Foreground="#D9FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
          <Button Command="{Binding ToggleTv}" Margin="0,12,0,0" Height="40" Cursor="Hand" AutomationProperties.Name="{Binding HeroCta}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg" CornerRadius="10" Background="#2EFFFFFF">
                  <TextBlock Text="{Binding HeroCta}" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#47FFFFFF"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="#47FFFFFF"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Border>

      <!-- Quick toggles -->
      <ItemsControl ItemsSource="{Binding Tiles}" Margin="8,8,8,4" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton Style="{StaticResource Tile}" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding Enabled}" AutomationProperties.Name="{Binding Label}">
              <StackPanel>
                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Sub}" FontSize="12.5" Opacity="0.82" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Footer actions -->
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="6">
        <StackPanel>
          <StackPanel.Resources>
            <Style x:Key="MenuRow" TargetType="Button">
              <Setter Property="Height" Value="42"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="12,0">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </StackPanel.Resources>
          <Button Style="{StaticResource MenuRow}" Command="{Binding Pause}">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" Data="M 9,5 V 19 M 15,5 V 19" Stroke="{DynamicResource Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock Text="{Binding PauseText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Command="{Binding OpenSettings}">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" Data="M 5.5,4 H 18.5 A 2.5,2.5 0 0 1 21,6.5 V 17.5 A 2.5,2.5 0 0 1 18.5,20 H 5.5 A 2.5,2.5 0 0 1 3,17.5 V 6.5 A 2.5,2.5 0 0 1 5.5,4 Z M 3,9 H 21" Stroke="{DynamicResource Ink2}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
              <TextBlock Text="Open settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuRow}" Command="{Binding Quit}">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" Data="M 12,3 V 11 M 7,6.3 A 7.5,7.5 0 1 0 17,6.3" Stroke="{DynamicResource Ink2}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock Text="Quit toolkit" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
