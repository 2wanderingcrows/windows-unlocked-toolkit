<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Unlocked Toolkit" Width="1100" Height="780" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgWin}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </Window.Resources>

  <Grid x:Name="Root" Background="{DynamicResource BgWin}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource BgSide}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,10">
          <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent}">
            <Path Data="M 8,14 H 22 V 23 H 8 Z M 11,14 V 11 A 4,4 0 0 1 18.5,9" Stroke="{DynamicResource AccentInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Unlocked Toolkit" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" Margin="0"/>
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding FooterText}" Style="{StaticResource Hint}" Margin="12,8,0,0"/>
        <StackPanel>
          <TextBlock Text="Tools" Style="{StaticResource Section}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="Nav" IsChecked="{Binding IsHome, Mode=TwoWay}" AutomationProperties.Name="All tools">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Stretch="Uniform" Data="M 3,3 H 10.5 V 10.5 H 3 Z M 13.5,3 H 21 V 10.5 H 13.5 Z M 3,13.5 H 10.5 V 21 H 3 Z M 13.5,13.5 H 21 V 21 H 13.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
              <TextBlock Text="All tools" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Nav" IsChecked="{Binding IsLean, Mode=TwoWay}" AutomationProperties.Name="Leanback Mode">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Stretch="Uniform" Data="M 6.5,8 H 17.5 A 4,4 0 0 1 21.4,12.9 L 20.4,17.2 A 2.3,2.3 0 0 1 16.4,18.1 L 14.8,16 H 9.2 L 7.6,18.1 A 2.3,2.3 0 0 1 3.6,17.2 L 2.6,12.9 A 4,4 0 0 1 6.5,8 Z M 7.5,11 V 14 M 6,12.5 H 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock Text="Leanback Mode" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Nav" IsChecked="{Binding IsMtj, Mode=TwoWay}" AutomationProperties.Name="Media Tab Jump">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Stretch="Uniform" Data="M 5,5 H 19 A 2.5,2.5 0 0 1 21.5,7.5 V 16.5 A 2.5,2.5 0 0 1 19,19 H 5 A 2.5,2.5 0 0 1 2.5,16.5 V 7.5 A 2.5,2.5 0 0 1 5,5 Z M 10,9.5 V 14.5 L 14.5,12 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
              <TextBlock Text="Media Tab Jump" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <TextBlock Text="Toolkit" Style="{StaticResource Section}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="Nav" IsChecked="{Binding IsLook, Mode=TwoWay}" AutomationProperties.Name="Appearance">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Stretch="Uniform" Data="M 12,3 A 9,9 0 1 0 12,21 C 13.2,21 13.8,20.1 13.8,19.2 C 13.8,17.9 12.8,17.6 12.8,16.5 C 12.8,15.6 13.5,15 14.4,15 H 16 A 5,5 0 0 0 21,10 C 21,6.1 17,3 12,3 Z M 7,11 A 0.6,0.6 0 1 0 8.2,11 A 0.6,0.6 0 1 0 7,11 Z M 10,7 A 0.6,0.6 0 1 0 11.2,7 A 0.6,0.6 0 1 0 10,7 Z M 14.4,7.5 A 0.6,0.6 0 1 0 15.6,7.5 A 0.6,0.6 0 1 0 14.4,7.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
              <TextBlock Text="Appearance" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Nav" IsChecked="{Binding IsAbout, Mode=TwoWay}" AutomationProperties.Name="Updates and about">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Stretch="Uniform" Data="M 3,12 A 9,9 0 1 0 21,12 A 9,9 0 1 0 3,12 Z M 12,11 V 16.5 M 12,7.6 V 7.9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock Text="Updates and about" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pages -->
    <ScrollViewer Grid.Column="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <Grid Margin="40,30,40,40" MaxWidth="880" HorizontalAlignment="Stretch">

        <!-- All tools -->
        <StackPanel Visibility="{Binding IsHome, Converter={StaticResource Vis}}">
          <TextBlock Text="All tools" Style="{StaticResource H1}"/>
          <TextBlock Text="Everything runs quietly in the background. Turn a tool off here and it stays off until you turn it back on." Style="{StaticResource Lede}" Margin="0,6,0,22"/>
          <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="18" Opacity="{Binding CardOpacity}">
                  <StackPanel>
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" Visibility="{Binding Installed, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Name}"/>
                      <Border Width="40" Height="40" CornerRadius="11" Background="{Binding Tile}">
                        <TextBlock Text="{Binding Mono}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0"/>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Blurb}" Style="{StaticResource Label}" Foreground="{DynamicResource Ink2}" Margin="0,14,0,14"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Secondary}" Content="Settings" Command="{Binding Open}" Visibility="{Binding Installed, Converter={StaticResource Vis}}"/>
                      <Border CornerRadius="13" Background="{DynamicResource Soft}" Padding="10,4" Visibility="{Binding NotInstalled, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource Hint}" Margin="0"/>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Leanback Mode -->
        <Border Visibility="{Binding IsLean, Converter={StaticResource Vis}}">
        <StackPanel DataContext="{Binding Lean}">
          <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="13,0,0,13" Background="{Binding HeroBrush}" MinHeight="196" Padding="20,22,20,0">
                <Border Width="236" Height="146" VerticalAlignment="Bottom" CornerRadius="10,10,0,0" Background="#16161C" Padding="8,8,8,0">
                  <Border CornerRadius="4,4,0,0" Background="{Binding ScreenBrush}" ClipToBounds="True">
                    <StackPanel VerticalAlignment="Center" Margin="14,0">
                      <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding PreviewScale}" ScaleY="{Binding PreviewScale}"/></StackPanel.LayoutTransform>
                      <Border Height="5" Width="110" HorizontalAlignment="Left" CornerRadius="2.5" Background="#EBFFFFFF"/>
                      <Border Height="5" Width="70" HorizontalAlignment="Left" CornerRadius="2.5" Background="#99FFFFFF" Margin="0,6,0,8"/>
                      <UniformGrid Columns="3" Width="140" HorizontalAlignment="Left">
                        <Border Height="20" CornerRadius="4" Background="#47FFFFFF" Margin="0,0,5,0"/>
                        <Border Height="20" CornerRadius="4" Background="#47FFFFFF" Margin="0,0,5,0"/>
                        <Border Height="20" CornerRadius="4" Background="#47FFFFFF"/>
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                </Border>
              </Border>
              <StackPanel Grid.Column="1" Margin="24,22" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Leanback Mode" Style="{StaticResource H1}" Margin="0,8,0,0"/>
                <TextBlock Text="Turn on a controller and your PC gets big and couch-friendly. Turn it off and everything goes back." Style="{StaticResource Lede}"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button Style="{StaticResource Primary}" Content="{Binding CtaText}" Command="{Binding ToggleTv}" IsEnabled="{Binding Running}" Margin="0,0,12,0"/>
                  <TextBlock Text="{Binding HotkeyHint}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Text="{Binding Problem}" Style="{StaticResource Hint}" Foreground="#C2410C" Margin="0,10,0,0" Visibility="{Binding HasProblem, Converter={StaticResource Vis}}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource RowFirst}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbMode" Content="Automatic" IsChecked="{Binding ModeAuto, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbMode" Content="Always Leanback" IsChecked="{Binding ModeTv, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbMode" Content="Always desktop" IsChecked="{Binding ModeDesk, Mode=TwoWay}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="When to use Leanback mode" Style="{StaticResource CardTitle}"/><TextBlock Text="Automatic follows your controller." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StayWhenAsleep, Mode=TwoWay}" AutomationProperties.Name="Stay in Leanback mode when the controller falls asleep"/>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Stay in Leanback mode when the controller falls asleep" Style="{StaticResource Label}"/><TextBlock Text="{Binding AsleepHint}" Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleText}" Style="{StaticResource Value}"/>
                  <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Minimum="100" Maximum="300" TickFrequency="25" Value="{Binding TvScale, Mode=TwoWay}" AutomationProperties.Name="Size of everything in Leanback mode"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Size of everything in Leanback mode" Style="{StaticResource Label}"/><TextBlock Text="{Binding ScaleHint}" Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding DeskScaleText}" Style="{StaticResource Value}"/>
                  <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Minimum="100" Maximum="250" TickFrequency="25" Value="{Binding DeskScale, Mode=TwoWay}" AutomationProperties.Name="Size of everything in desktop mode"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Size of everything in desktop mode" Style="{StaticResource Label}"/><TextBlock Text="Your normal Windows scaling." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding PointerText}" Style="{StaticResource Value}"/>
                  <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Minimum="32" Maximum="128" TickFrequency="8" Value="{Binding TvPointer, Mode=TwoWay}" AutomationProperties.Name="Pointer size in Leanback mode"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Pointer size in Leanback mode" Style="{StaticResource Label}"/><TextBlock Text="Windows' default is 32." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbTrans" Content="Soft blur" IsChecked="{Binding TransSmooth, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbTrans" Content="Instant" IsChecked="{Binding TransInstant, Mode=TwoWay}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Transition" Style="{StaticResource Label}"/><TextBlock Text="How the screen changes between modes." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{Binding HotkeyButtonText}" Command="{Binding ChangeHotkey}" VerticalAlignment="Center"/>
                  <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding HotkeyKeys}" Focusable="False" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,2" Background="{DynamicResource BgCard}" Padding="8,3" Margin="0,0,5,0">
                          <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{DynamicResource Ink}"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Switch shortcut" Style="{StaticResource Label}"/><TextBlock Text="{Binding HotkeyNote}" Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <Border Style="{StaticResource RowFirst}" Padding="18,16,18,6">
                  <StackPanel><TextBlock Text="Controller as mouse" Style="{StaticResource CardTitle}"/><TextBlock Text="Left stick moves the pointer." Style="{StaticResource Hint}"/></StackPanel>
                </Border>
                <Border Padding="18,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" Style="{StaticResource Value}" Width="44"/>
                    <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Width="140" Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Speed, Mode=TwoWay}" AutomationProperties.Name="Pointer speed"/>
                    <TextBlock Text="Pointer speed" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Padding="18,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FastText}" Style="{StaticResource Value}" Width="44"/>
                    <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Width="140" Minimum="1.5" Maximum="4" TickFrequency="0.1" Value="{Binding Fast, Mode=TwoWay}" AutomationProperties.Name="Fast pointer speed"/>
                    <TextBlock Text="Fast pointer (hold Y)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Padding="18,8,18,12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScrollText}" Style="{StaticResource Value}" Width="44"/>
                    <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Width="140" Minimum="5" Maximum="40" TickFrequency="1" Value="{Binding Scroll, Mode=TwoWay}" AutomationProperties.Name="Scroll speed"/>
                    <TextBlock Text="Scroll speed" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Curve, Mode=TwoWay}" AutomationProperties.Name="Smooth acceleration"/>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Smooth acceleration" Style="{StaticResource Label}"/><TextBlock Text="Small tilts move gently, full tilt moves fast." Style="{StaticResource Hint}"/></StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PauseGames, Mode=TwoWay}" AutomationProperties.Name="Step aside for games"/>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Step aside for games" Style="{StaticResource Label}"/><TextBlock Text="Pauses the mouse while a game is in front." Style="{StaticResource Hint}"/></StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <Border Style="{StaticResource RowFirst}" Padding="18,16,18,8">
                  <StackPanel><TextBlock Text="Buttons" Style="{StaticResource CardTitle}"/><TextBlock Text="Click an action to change it." Style="{StaticResource Hint}"/></StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Mappings}" Margin="14,0,14,12" Focusable="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="4">
                        <Border DockPanel.Dock="Left" MinWidth="32" Height="30" CornerRadius="15" Background="{DynamicResource Soft}" Padding="6,0" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Button}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource Secondary}" Command="{Binding Cycle}" HorizontalContentAlignment="Stretch" Padding="10,0" AutomationProperties.Name="{Binding Aria}">
                          <DockPanel>
                            <Path DockPanel.Dock="Right" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Mut}" StrokeThickness="1.6" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding Action}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                        </Button>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource RowFirst}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbDetect" Content="All controllers" IsChecked="{Binding DetectAll, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="LbDetect" Content="Xbox-style only" IsChecked="{Binding DetectXInput, Mode=TwoWay}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Controllers" Style="{StaticResource CardTitle}"/><TextBlock Text="Xbox, PlayStation, Switch Pro, 8BitDo and other Bluetooth or 2.4 GHz pads." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Row}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{Binding ActionText}" Command="{Binding Act}" Visibility="{Binding HasAction, Converter={StaticResource Vis}}" VerticalAlignment="Center"/>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}"/></StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
        </Border>

        <!-- Media Tab Jump -->
        <Border Visibility="{Binding IsMtj, Converter={StaticResource Vis}}">
        <StackPanel DataContext="{Binding Mtj}">
          <TextBlock Text="Media Tab Jump" Style="{StaticResource H1}"/>
          <TextBlock Text="Click the now-playing card in the volume flyout to jump to the tab that's playing it." Style="{StaticResource Lede}" Margin="0,6,0,20"/>
          <TextBlock Text="{Binding Problem}" Style="{StaticResource Hint}" Foreground="#C2410C" Margin="0,0,0,14" Visibility="{Binding HasProblem, Converter={StaticResource Vis}}"/>
          <Border CornerRadius="14" Margin="0,0,0,16" Padding="20,44,20,36">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B4152" Offset="0"/><GradientStop Color="#1F2330" Offset="1"/></LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" Width="360">
              <Grid>
                <Border CornerRadius="18" Margin="-8" Background="{Binding GlowBrush}" Opacity="{Binding GlowOpacity}">
                  <Border.Effect><BlurEffect Radius="{Binding GlowBlur}"/></Border.Effect>
                </Border>
                <Border CornerRadius="12" Background="#F0202028" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14">
                  <DockPanel>
                    <Border Width="52" Height="52" CornerRadius="8" DockPanel.Dock="Left">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF8A5B" Offset="0"/><GradientStop Color="#EF4F7B" Offset="0.55"/><GradientStop Color="#7B4DFF" Offset="1"/></LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Microsoft Edge" FontSize="12.5" Foreground="#B3FFFFFF"/>
                      <TextBlock Text="Lo-fi beats to code to" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                      <TextBlock Text="Sample media card" FontSize="12" Foreground="#80FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Grid>
              <TextBlock Text="Preview of the hover glow" FontSize="12.5" Foreground="#C7FFFFFF" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource RowFirst}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GlowOn, Mode=TwoWay}" AutomationProperties.Name="Hover glow"/>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Hover glow" Style="{StaticResource CardTitle}"/><TextBlock Text="A soft light around the card while your pointer is on it." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <StackPanel>
                  <TextBlock Text="Glow colour" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                  <ItemsControl ItemsSource="{Binding Styles}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton GroupName="GlowStyle" IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand" Margin="0,0,8,8" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Label}">
                          <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                              <Border x:Name="Bg" CornerRadius="18" Height="36" Padding="5,0,13,0" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                  <Ellipse Width="24" Height="24" Fill="{Binding Swatch}" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
                                  <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="{DynamicResource Ink}"/>
                                </StackPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                  <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </RadioButton.Template>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding BrightnessText}" Style="{StaticResource Value}"/>
                  <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Minimum="10" Maximum="150" TickFrequency="5" Value="{Binding Brightness, Mode=TwoWay}" AutomationProperties.Name="Glow brightness"/>
                  <TextBlock Text="Brightness" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Value}"/>
                  <Slider DockPanel.Dock="Right" Style="{StaticResource Range}" Minimum="50" Maximum="200" TickFrequency="10" Value="{Binding Size, Mode=TwoWay}" AutomationProperties.Name="Glow size"/>
                  <TextBlock Text="Glow size" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Visibility="{Binding IsLook, Converter={StaticResource Vis}}">
        <StackPanel DataContext="{Binding Look}">
          <TextBlock Text="Appearance" Style="{StaticResource H1}"/>
          <TextBlock Text="Make the toolkit yours. Changes apply to this window, the tray menu and the tray icon." Style="{StaticResource Lede}" Margin="0,6,0,20"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource RowFirst}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" GroupName="Theme" Content="Match Windows" IsChecked="{Binding ThemeSystem, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="Theme" Content="Light" IsChecked="{Binding ThemeLight, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="Theme" Content="Dark" IsChecked="{Binding ThemeDark, Mode=TwoWay}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="Theme" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}" Padding="18,14,18,6">
                <StackPanel>
                  <TextBlock Text="Accent colour" Style="{StaticResource Label}"/>
                  <TextBlock Text="Used for switches, sliders and the tray icon. The first one follows your Windows accent." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
                  <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Background="{Binding Swatch}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" GroupName="TrayIcon" Content="Lock" IsChecked="{Binding IconLock, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="TrayIcon" Content="Dot" IsChecked="{Binding IconDot, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" GroupName="TrayIcon" Content="Mode" IsChecked="{Binding IconMode, Mode=TwoWay}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Tray icon" Style="{StaticResource Label}"/><TextBlock Text="Mode shows a TV in Leanback mode and a monitor in desktop mode." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Motion, Mode=TwoWay}" AutomationProperties.Name="Motion"/>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Motion" Style="{StaticResource Label}"/><TextBlock Text="Animate the tray menu as it opens." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        </Border>

        <!-- Updates and about -->
        <Border Visibility="{Binding IsAbout, Converter={StaticResource Vis}}">
        <StackPanel DataContext="{Binding About}">
          <TextBlock Text="Updates and about" Style="{StaticResource H1}"/>
          <TextBlock Text="Free and open source. Every tool is readable code on GitHub." Style="{StaticResource Lede}" Margin="0,6,0,20"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource RowFirst}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Get the latest version" Command="{Binding OpenWebsite}" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding VersionTitle}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding VersionHint}" Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows"/>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Start with Windows" Style="{StaticResource Label}"/><TextBlock Text="Put the toolkit in the tray when you sign in." Style="{StaticResource Hint}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <WrapPanel>
                  <Button Style="{StaticResource Secondary}" Content="View source on GitHub" Command="{Binding OpenGitHub}" Margin="0,0,10,0"/>
                  <Button Style="{StaticResource Secondary}" Content="Report a problem" Command="{Binding OpenIssues}" Margin="0,0,10,0"/>
                  <Button Style="{StaticResource Secondary}" Content="Open logs folder" Command="{Binding OpenLogs}"/>
                </WrapPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
